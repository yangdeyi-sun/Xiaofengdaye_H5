{
  "name": "xiaofengdaye-h5",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --minify",
    "audio": "node scripts/convert-audio.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs && node scripts/test-platform.mjs && node scripts/test-ui.mjs",
    "sim": "node scripts/run-sim.mjs sim 4 -v",
    "perf": "node scripts/run-sim.mjs perf",
    "dev": "node scripts/dev.mjs",
    "build:douyin": "node scripts/build-douyin.mjs",
    "build:douyin:release": "node scripts/build-douyin.mjs --release",
    "prepare:android": "node scripts/prepare-android.mjs",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "build:android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Release",
    "release:check": "node scripts/check-release.mjs",
    "test:release": "node scripts/test-release.mjs",
    "dev:douyin": "node scripts/dev.mjs --canvas-preview"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "yoga-layout-prebuilt": "^1.10.0"
  }
}
